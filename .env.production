# ── Inertia — PRODUCTION environment template ───────────────────────
# Copy to .env on the VPS (or load with NODE_ENV=production) and fill in
# real values. Replace https://yourdomain.com with your actual domain.
#
# IMPORTANT: The Discord Developer Portal → OAuth2 → Redirects must list
#   https://yourdomain.com/api/auth/discord/callback
# exactly (scheme + host + path), or token exchange will fail.

# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Public base URL — drives all OAuth redirect URIs. MUST match the domain
# registered in the Discord + Google developer consoles.
PUBLIC_URL=https://yourdomain.com

INERTIA_ADMIN_PASSWORD=change-me-to-a-long-random-string
INERTIA_SECRET_KEY=change-me-to-a-long-random-secret
MONGO_URI=

# ── OAuth Providers ─────────────────────────────────────────────────
# Redirect URIs to register:
#   Google:  https://yourdomain.com/api/auth/google/callback
#   Discord: https://yourdomain.com/api/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Discord Bot Tokens ──────────────────────────────────────────────
SALES_BOT_TOKEN=
TICKET_BOT_TOKEN=
MANAGEMENT_BOT_TOKEN=
AUTHING_BOT_TOKEN=
VOUCHES_BOT_TOKEN=

# ── Discord Server / Channel IDs ────────────────────────────────────
DISCORD_GUILD_ID=
VOUCHES_CHANNEL_ID=
TICKET_SUPPORT_CHANNEL_ID=
SALES_CHANNEL_ID=
MANAGEMENT_CHANNEL_ID=

# ── Discord Role IDs (drive website RBAC) ───────────────────────────
INERTIA_ROLE_ID=
SERVER_BOOSTER_ROLE_ID=
CUSTOMER_ROLE_ID=
SUPPORT_ROLE_ID=
MANAGEMENT_ROLE_ID=
RESELLER_ROLE_ID=
MEDIA_ROLE_ID=
MEMBER_ROLE_ID=

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
