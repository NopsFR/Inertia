.292z"/></svg>'.repeat(5)+'</div><p style="font-size:13px;color:rgba(255,255,255,.6);line-height:1.6;margin-bottom:10px">'+['Amazing marketplace. Got my CS2 scripts instantly and they work perfectly. Will definitely buy again!','Best prices for Roblox tools. Support is super responsive and helpful. Been a loyal customer for months.','The Warzone cheats are undetected and work flawlessly. Highly recommend Inertia to anyone looking for quality tools.','Fast delivery, great support, and the products actually work as described. What more could you ask for?','Tried multiple marketplaces before finding Inertia. This is by far the most professional and reliable one.'][Math.floor(Math.random()*5)]+'</p><div style="display:flex;align-items:center;justify-content:space-between;padding-top:10px;border-top:1px solid rgba(255,255,255,.04)"><span style="font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.25);color:#60a5fa;text-transform:uppercase;letter-spacing:.5px">'+['CS2','ROBLOX','WARZONE','RUST','CS2'][Math.floor(Math.random()*5)]+'</span><span style="font-size:10px;color:rgba(59,130,246,.6);display:flex;align-items:center;gap:4px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 01-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 011-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 011.52 0C14.51 3.81 17 5 19 5a1 1 0 011 1z"/><path d="m9 12 2 2 4-4"/></svg>Verified</span></div></div>'].join('')+'</div><div style="text-align:center;padding:20px;border:1px solid rgba(255,255,255,.06);border-radius:12px;background:rgba(255,255,255,.01)"><p style="font-size:13px;color:rgba(255,255,255,.4);margin-bottom:4px">Want to leave a review?</p><p style="font-size:12px;color:rgba(255,255,255,.25)">Join our <span style="color:#a5b4fc">Discord server</span> and use the <code style="background:rgba(88,101,242,.1);padding:2px 6px;border-radius:4px;color:#a5b4fc">/review</code> bot command to share your experience. Verified purchases only.</p></div></section>')}

  function faqPage(){var C=(site&&site.content)||{};var head=C.faqHead||{eyebrow:'FAQ',title:'FREQUENTLY ASKED QUESTIONS'};var items=(Array.isArray(C.faq)&&C.faq.length)?C.faq:[{q:'What is Inertia?',a:'Inertia is a curated marketplace for gaming tools, scripts, executors, and accounts, delivered instantly after purchase through a clean, modern platform.'},{q:'How does purchasing work?',a:'Browse our catalog, add products to your cart, and checkout securely. After payment, your product is delivered instantly.'},{q:'What payment methods are accepted?',a:'We accept cryptocurrency and card payments. Crypto checkouts require no personal information beyond a valid email for delivery.'},{q:'Can I get a refund?',a:'Refunds are handled on a case-by-case basis. If a product does not work as described, contact our support team on Discord.'},{q:'How do I contact support?',a:'Join our Discord server for the fastest support. Our team is available 24/7.'}];return shell('<section class="page py-16"><div style="text-align:center;margin-bottom:40px"><p class="section-header" style="margin-bottom:8px">'+esc(head.eyebrow)+'</p><h2 style="font-size:clamp(28px,4vw,48px);font-weight:900;color:#fff;letter-spacing:-1px;margin-bottom:12px">'+esc(head.title)+'</h2><p style="font-size:14px;color:rgba(255,255,255,.35);max-width:500px;margin:0 auto">Everything you need to know about Inertia and our products.</p></div><div style="max-width:700px;margin:0 auto;display:flex;flex-direction:column;gap:8px">'+items.map(function(f){return'<details class="faq-item"><summary>'+esc(f.q)+'</summary><div class="faq-answer">'+esc(f.a)+'</div></details>'}).join('')+'</div></section>')}

  function dashboardLoginPage(){return shell('<section class="page" style="display:flex;align-items:center;justify-content:center;min-height:70vh"><div class="glass-card" style="max-width:420px;width:100%;padding:32px;border-color:rgba(59,130,246,.15)"><a data-nav href="/" style="font-size:18px;font-weight:900;color:#fff;text-decoration:none">inertia<span style="color:var(--neon-accent)">.</span></a><h1 style="font-size:28px;font-weight:900;margin-top:24px;color:#fff">Admin Panel</h1><p style="font-size:13px;color:rgba(255,255,255,.35);margin-bottom:24px">Authorized personnel only.</p><div style="display:flex;flex-direction:column;gap:12px"><div><label style="display:block;font-size:11px;font-weight:600;color:rgba(255,255,255,.35);margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px">Admin Password</label><input id="login-password" type="password" class="field" placeholder="Enter admin password" onkeydown="if(event.key===\'Enter\')doAdminLogin()" /></div><button onclick="doAdminLogin()" class="btn-primary" style="width:100%;padding:13px;font-size:14px">Sign in as Admin</button><div style="margin-top:8px;padding-top:16px;border-top:1px solid rgba(255,255,255,.05)"><label style="display:block;font-size:11px;font-weight:600;color:rgba(255,255,255,.35);margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px">Owner Secret Key</label><input id="owner-secret" type="password" class="field" placeholder="Enter owner secret key" onkeydown="if(event.key===\'Enter\')doOwnerLogin()" /></div><button onclick="doOwnerLogin()" class="btn-glass" style="width:100%;padding:13px;font-size:14px;text-align:center">Sign in as Owner</button></div></div></section>')}
  async function doAdminLogin(){var p=document.getElementById('login-password').value;if(!p)return notice('Enter password','red');var r=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:p})});if(!r.ok){var d=await r.json().catch(function(){return{error:'Login failed'}});return notice(d.error,'red')}adminState=await(await fetch('/api/admin/state')).json();go('/dashboard')}
  async function doOwnerLogin(){var s=document.getElementById('owner-secret').value;if(!s)return notice('Enter secret key','red');var r=await fetch('/api/auth/owner-login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({secret:s})});if(!r.ok){var d=await r.json().catch(function(){return{error:'Login failed'}});return notice(d.error,'red')}ownerState=await(await fetch('/api/admin/state')).json();go('/dashboard')}
  async function adminLogout(){await fetch('/api/auth/logout',{method:'POST'});await fetch('/api/auth/owner-logout',{method:'POST'});adminState=null;ownerState=null;go('/')}

  async function loadDashboardData(){
    try{var r=await fetch('/api/admin/stats');if(r.ok)adminStats=await r.json()}catch(e){}
    try{r=await fetch('/api/admin/logs?limit=200&type='+logFilter);if(r.ok){var d=await r.json();adminLogs=d.logs}}catch(e){}
    try{r=await fetch('/api/admin/users');if(r.ok){d=await r.json();adminUsers=d.users}}catch(e){}
  }
  function dashboardPage(){
    if(!adminState&&!ownerState)return dashboardLoginPage();
    loadDashboardData();
    var isOwner=!!ownerState,tabs=[['products','Products'],['add-product','Add Product'],['hero','Hero / Section'],['content','Content'],['users','User Manager'],['logs','Logs'],['stats','Stats']],tab=dashboardTab||'products';
    return shell('<section class="page py-12 dash"><div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:32px"><div><p class="section-header">'+(isOwner?'Owner':'Admin')+' Dashboard</p><h1 style="font-size:32px;font-weight:900;color:#fff;letter-spacing:-1px;margin-top:4px">Management console</h1></div><button onclick="adminLogout()" class="btn-glass" style="padding:10px 20px">Log out</button></div><div style="display:flex;gap:4px;margin-bottom:20px;border-bottom:1px solid rgba(255,255,255,.05);padding-bottom:12px;overflow-x:auto">'+tabs.map(function(x){var k=x[0],n=x[1];return'<button onclick="dashboardTab=\''+k+'\';render()" class="tab-btn'+(tab===k?' active':'')+'">'+n+'</button>'}).join('')+'</div>'+(tab==='products'?productsTab():tab==='add-product'?addProductTab():tab==='hero'?heroTab():tab==='content'?contentTab():tab==='users'?usersTab(isOwner):tab==='logs'?logsTab(isOwner):statsTab())+'</section>')
  }
  function fieldLabel(t){return'<span style="display:block;font-size:10px;font-weight:700;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px">'+t+'</span>'}
  function optRows(pi,options){
    var list=Array.isArray(options)?options:[];
    return'<div data-opts-for="'+pi+'" style="display:flex;flex-direction:column;gap:8px">'+list.map(function(o,oi){return optRow(pi,oi,o)}).join('')+'</div>'
      +'<button onclick="addOption('+pi+')" class="btn-glass" style="margin-top:10px">+ Add duration option</button>';
  }
  function optRow(pi,oi,o){o=o||{};
    return'<div data-opt-row="'+pi+':'+oi+'" style="display:grid;grid-template-columns:1.3fr 1fr .9fr .8fr 1fr auto;gap:8px;align-items:center;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:10px">'
      +'<input class="field" data-ok="label" value="'+esc(o.label||'')+'" placeholder="Label (e.g. Day Key)">'
      +'<input class="field" data-ok="duration" value="'+esc(o.duration||'')+'" placeholder="Duration (e.g. 1 Day)">'
      +'<input class="field" data-ok="price" type="number" step="0.01" min="0" value="'+(o.price!=null?o.price:'')+'" placeholder="Price">'
      +'<select class="field" data-ok="currency"><option'+((o.currency||'USD')==='USD'?' selected':'')+'>USD</option><option'+(o.currency==='EUR'?' selected':'')+'>EUR</option></select>'
      +'<select class="field" data-ok="stock"><option'+((o.stock||'IN STOCK')==='IN STOCK'?' selected':'')+'>IN STOCK</option><option'+(o.stock==='OUT OF STOCK'?' selected':'')+'>OUT OF STOCK</option></select>'
      +'<button onclick="removeOption('+pi+','+oi+')" class="btn-danger" style="padding:6px 10px">✕</button>'
      +'</div>';
  }
  function productsTab(){var s=adminState||ownerState;return'<div style="display:flex;flex-direction:column;gap:16px"><div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px"><p style="font-size:13px;color:rgba(255,255,255,.35)">'+s.products.length+' products · edit everything below, then save</p><button onclick="saveProducts()" class="btn-primary" style="padding:10px 20px;font-size:13px">Save All Products</button></div>'
    +s.products.map(function(p,i){
      return'<div class="glass" style="border-radius:14px;padding:20px;border:1px solid rgba(255,255,255,.07)">'
      +'<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px"><h3 style="font-size:15px;font-weight:800;color:#fff;margin:0">'+esc(p.name||'Untitled')+'</h3><button onclick="deleteProduct('+i+')" class="btn-danger">Remove Product</button></div>'
      // basic fields
      +'<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:16px">'
      +'<label>'+fieldLabel('Name')+'<input class="field" data-pk="name" data-pi="'+i+'" value="'+esc(p.name)+'"></label>'
      +'<label>'+fieldLabel('Game')+'<input class="field" data-pk="game" data-pi="'+i+'" value="'+esc(p.game)+'"></label>'
      +'<label>'+fieldLabel('Base Price')+'<input class="field" data-pk="price" data-pi="'+i+'" type="number" step="0.01" value="'+p.price+'"></label>'
      +'<label>'+fieldLabel('Currency')+'<select class="field" data-pk="currency" data-pi="'+i+'"><option'+(p.currency==='USD'?' selected':'')+'>USD</option><option'+(p.currency==='EUR'?' selected':'')+'>EUR</option></select></label>'
      +'<label>'+fieldLabel('Stock')+'<select class="field" data-pk="stock" data-pi="'+i+'"><option'+(p.stock==='IN STOCK'?' selected':'')+'>IN STOCK</option><option'+(p.stock==='OUT OF STOCK'?' selected':'')+'>OUT OF STOCK</option></select></label>'
      +'<label>'+fieldLabel('Rating')+'<input class="field" data-pk="rating" data-pi="'+i+'" type="number" step="0.1" min="0" max="5" value="'+p.rating+'"></label>'
      +'<label>'+fieldLabel('Reviews')+'<input class="field" data-pk="reviews" data-pi="'+i+'" type="number" min="0" value="'+(p.reviews||0)+'"></label>'
      +'</div>'
      // description + details
      +'<label style="display:block;margin-bottom:12px">'+fieldLabel('Short Description (card + detail intro)')+'<textarea class="field" data-pk="description" data-pi="'+i+'" style="min-height:56px">'+esc(p.description)+'</textarea></label>'
      +'<label style="display:block;margin-bottom:12px">'+fieldLabel('Details (long text, shown on product page)')+'<textarea class="field" data-pk="details" data-pi="'+i+'" style="min-height:100px">'+esc(p.details||'')+'</textarea></label>'
      +'<label style="display:block;margin-bottom:16px">'+fieldLabel('Features (one per line)')+'<textarea class="field" data-pk="features" data-pi="'+i+'" style="min-height:80px" placeholder="One feature per line">'+esc((Array.isArray(p.features)?p.features:[]).join('\n'))+'</textarea></label>'
      // media
      +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">'
      +'<div><label style="display:block;margin-bottom:6px">'+fieldLabel('Image URL')+'<input class="field" data-pk="image" data-pi="'+i+'" value="'+esc(p.image||'')+'" placeholder="/public/uploads/..."></label>'+dz('p:'+i+':image','image/png,image/jpeg,image/webp,image/gif','Product Image',p.image||'',false)+'</div>'
      +'<div><label style="display:block;margin-bottom:6px">'+fieldLabel('Video URL')+'<input class="field" data-pk="video" data-pi="'+i+'" value="'+esc(p.video||'')+'" placeholder="/public/uploads/..."></label>'+dz('p:'+i+':video','video/mp4,video/webm','Product Video',p.video||'',true)+'</div>'
      +'</div>'
      // duration options
      +'<div style="border-top:1px solid rgba(255,255,255,.06);padding-top:14px">'+fieldLabel('Duration Keys — Day / Week / Month / Lifetime pricing')+optRows(i,p.options)+'</div>'
      +'</div>';
    }).join('')+'</div>'}
  function addProductTab(){var d=newProductDraft||{};return'<div class="glass" style="border-radius:14px;padding:24px;max-width:720px"><h2 style="font-size:20px;font-weight:800;margin-bottom:6px;color:#fff">Add New Product</h2><p style="font-size:12px;color:rgba(255,255,255,.35);margin-bottom:20px">Fill in the product details and set its duration keys below — everything saves in one step.</p>'
    +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">'
    +'<label>'+fieldLabel('Name')+'<input id="new-p-name" class="field" placeholder="Product name" value="'+esc(d.name||'')+'"></label>'
    +'<label>'+fieldLabel('Game')+'<input id="new-p-game" class="field" placeholder="e.g. ROBLOX, CS2" value="'+esc(d.game||'')+'"></label>'
    +'<label>'+fieldLabel('Base Price')+'<input id="new-p-price" class="field" type="number" step="0.01" placeholder="0.00" value="'+(d.price!=null&&d.price!==''?d.price:'')+'"></label>'
    +'<label>'+fieldLabel('Currency')+'<select id="new-p-currency" class="field"><option'+(d.currency==='EUR'?'':' selected')+'>USD</option><option'+(d.currency==='EUR'?' selected':'')+'>EUR</option></select></label>'
    +'<label>'+fieldLabel('Stock')+'<select id="new-p-stock" class="field"><option'+(d.stock==='OUT OF STOCK'?'':' selected')+'>IN STOCK</option><option'+(d.stock==='OUT OF STOCK'?' selected':'')+'>OUT OF STOCK</option></select></label>'
    +'<label>'+fieldLabel('Rating')+'<input id="new-p-rating" class="field" type="number" step="0.1" value="'+(d.rating!=null&&d.rating!==''?d.rating:'5')+'" min="0" max="5"></label>'
    +'<label style="grid-column:1/-1">'+fieldLabel('Short Description')+'<textarea id="new-p-desc" class="field" style="min-height:60px" placeholder="Product description">'+esc(d.desc||'')+'</textarea></label>'
    +'<label style="grid-column:1/-1">'+fieldLabel('Details (long text)')+'<textarea id="new-p-details" class="field" style="min-height:90px" placeholder="Longer product details">'+esc(d.details||'')+'</textarea></label>'
    +'<label style="grid-column:1/-1">'+fieldLabel('Features (one per line)')+'<textarea id="new-p-features" class="field" style="min-height:70px" placeholder="One feature per line">'+esc(d.features||'')+'</textarea></label>'
    +'<label style="grid-column:1/-1">'+fieldLabel('Image URL')+'<input id="new-p-image" class="field" placeholder="https://... or /public/uploads/..." value="'+esc(d.image||'')+'"></label>'
    +'<div style="grid-column:1/-1">'+dz('new:image','image/png,image/jpeg,image/webp,image/gif','Product Image',d.image||'',false)+'</div>'
    +'<label style="grid-column:1/-1">'+fieldLabel('Video URL')+'<input id="new-p-video" class="field" placeholder="https://... or /public/uploads/..." value="'+esc(d.video||'')+'"></label>'
    +'<div style="grid-column:1/-1">'+dz('new:video','video/mp4,video/webm','Product Video','',true)+'</div>'
    +'</div>'
    +'<div style="border-top:1px solid rgba(255,255,255,.06);margin-top:18px;padding-top:16px">'+fieldLabel('Duration Keys — how long the customer is buying access for')
    +'<p style="font-size:11px;color:rgba(255,255,255,.3);margin:-2px 0 12px">Add a row per duration (e.g. Day Key / 1 Day / 3.99). Leave empty to sell at the base price only.</p>'
    +'<div id="new-opts" style="display:flex;flex-direction:column;gap:8px">'+(newProductOpts.length?newProductOpts.map(function(o,oi){return newOptRow(oi,o)}).join(''):'')+'</div>'
    +'<button onclick="addNewOption()" class="btn-glass" style="margin-top:10px">+ Add duration key</button>'
    +'</div>'
    +'<button onclick="addNewProductAndSave()" class="btn-primary" style="margin-top:18px;width:100%;padding:12px">Add & Save Product</button></div>'}
  function newOptRow(oi,o){o=o||{};
    return'<div data-newopt-row="'+oi+'" style="display:grid;grid-template-columns:1.3fr 1fr .9fr .8fr 1fr auto;gap:8px;align-items:center;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:10px">'
      +'<input class="field" data-nok="label" value="'+esc(o.label||'')+'" placeholder="Label (e.g. Day Key)">'
      +'<input class="field" data-nok="duration" value="'+esc(o.duration||'')+'" placeholder="Duration (e.g. 1 Day)">'
      +'<input class="field" data-nok="price" type="number" step="0.01" min="0" value="'+(o.price!=null?o.price:'')+'" placeholder="Price">'
      +'<select class="field" data-nok="currency"><option'+((o.currency||'USD')==='USD'?' selected':'')+'>USD</option><option'+(o.currency==='EUR'?' selected':'')+'>EUR</option></select>'
      +'<select class="field" data-nok="stock"><option'+((o.stock||'IN STOCK')==='IN STOCK'?' selected':'')+'>IN STOCK</option><option'+(o.stock==='OUT OF STOCK'?' selected':'')+'>OUT OF STOCK</option></select>'
      +'<button onclick="removeNewOption('+oi+')" class="btn-danger" style="padding:6px 10px">✕</button>'
      +'</div>';
  }
  function collectNewOpts(){var wrap=document.getElementById('new-opts');if(!wrap)return;newProductOpts=[];wrap.querySelectorAll('[data-newopt-row]').forEach(function(row){var o={};row.querySelectorAll('[data-nok]').forEach(function(f){o[f.dataset.nok]=f.dataset.nok==='price'?(Number(f.value)||0):f.value});newProductOpts.push(o)})}
  function collectNewDraft(){var g=function(id){var e=document.getElementById(id);return e?e.value:''};newProductDraft={name:g('new-p-name'),game:g('new-p-game'),price:g('new-p-price'),currency:g('new-p-currency'),stock:g('new-p-stock'),rating:g('new-p-rating'),desc:g('new-p-desc'),details:g('new-p-details'),features:g('new-p-features'),image:g('new-p-image'),video:g('new-p-video')}}
  function addNewOption(){collectNewDraft();collectNewOpts();newProductOpts.push({label:'',duration:'',price:0,currency:'USD',stock:'IN STOCK'});render()}
  function removeNewOption(i){collectNewDraft();collectNewOpts();newProductOpts.splice(i,1);render()}
  function heroTab(){var s=adminState||ownerState;var h=(s&&s.hero)||{};if(!heroDraft)heroDraft={title:h.title||'',highlight:h.highlight||'',description:h.description||'',image:h.image||'',video:h.video||''};return'<div class="glass" style="border-radius:12px;padding:24px;max-width:640px"><h2 style="font-size:20px;font-weight:700;margin-bottom:6px">Hero / Section Content</h2><p style="font-size:12px;color:rgba(255,255,255,.35);margin-bottom:20px">Edit the landing hero copy and background media. Saves to MongoDB.</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:14px"><label style="display:block;font-size:11px;font-weight:600;color:rgba(255,255,255,.35)">Title<input id="hero-title" class="field" value="'+esc(heroDraft.title)+'" placeholder="Move faster."></label><label style="display:block;font-size:11px;font-weight:600;color:rgba(255,255,255,.35)">Highlight<input id="hero-highlight" class="field" value="'+esc(heroDraft.highlight)+'" placeholder="Play smarter."></label><label style="display:block;font-size:11px;font-weight:600;color:rgba(255,255,255,.35);grid-column:1/-1">Description<textarea id="hero-description" class="field" style="min-height:80px" placeholder="Short tagline...">'+esc(heroDraft.description)+'</textarea></label><label style="display:block;font-size:11px;font-weight:600;color:rgba(255,255,255,.35);grid-column:1/-1">Image URL<input id="hero-image" class="field" value="'+esc(heroDraft.image)+'" placeholder="/public/uploads/..."></label><div style="grid-column:1/-1">'+dz('hero:image','image/png,image/jpeg,image/webp,image/gif','Hero Image',heroDraft.image,false)+'</div><label style="display:block;font-size:11px;font-weight:600;color:rgba(255,255,255,.35);grid-column:1/-1">Video URL<input id="hero-video" class="field" value="'+esc(heroDraft.video)+'" placeholder="/public/uploads/..."></label><div style="grid-column:1/-1">'+dz('hero:video','video/mp4,video/webm','Hero Video',heroDraft.video,true)+'</div></div><button onclick="saveHero()" class="btn-primary" style="margin-top:18px;width:100%;padding:12px">Save Hero Section</button></div>'}
  async function saveHero(){var s=adminState||ownerState;if(!s)return;s.hero={title:document.getElementById('hero-title').value,highlight:document.getElementById('hero-highlight').value,description:document.getElementById('hero-description').value,image:document.getElementById('hero-image').value,video:document.getElementById('hero-video').value};var r=await fetch('/api/admin/state',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(s)}),d=await r.json();if(!r.ok)return notice(d.error||'Save failed','red');if(ownerState)ownerState=d;else adminState=d;site=d;heroDraft=null;notice('Hero section saved')}

  // ===== BUNDLE TAB =====
  function bundleTab(){var s=adminState||ownerState;var b=(s&&s.bundle)||{eyebrow:'',title:'',categories:[],durations:[]};
    var cats=Array.isArray(b.categories)?b.categories:[];var durs=Array.isArray(b.durations)?b.durations:[];
    return'<div class="glass" style="border-radius:14px;padding:24px;max-width:820px"><div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:6px"><h2 style="font-size:20px;font-weight:800;color:#fff;margin:0">Bundle Builder</h2><button onclick="saveBundle()" class="btn-primary" style="padding:10px 20px;font-size:13px">Save Bundle</button></div><p style="font-size:12px;color:rgba(255,255,255,.35);margin-bottom:20px">Controls the "Build your bundle" section on the homepage.</p>'
    +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:22px">'
    +'<label>'+fieldLabel('Eyebrow')+'<input id="bnd-eyebrow" class="field" value="'+esc(b.eyebrow||'')+'" placeholder="Play without a trace"></label>'
    +'<label>'+fieldLabel('Title')+'<input id="bnd-title" class="field" value="'+esc(b.title||'')+'" placeholder="Build your bundle"></label>'
    +'</div>'
    +fieldLabel('Categories')
    +'<div id="bnd-cats" style="display:flex;flex-direction:column;gap:8px;margin-bottom:10px">'+cats.map(function(c,i){return bndCatRow(i,c)}).join('')+'</div>'
    +'<button onclick="addBndCat()" class="btn-glass" style="margin-bottom:22px">+ Add category</button>'
    +fieldLabel('Duration Tiers (multiplier applied to category base price)')
    +'<div id="bnd-durs" style="display:flex;flex-direction:column;gap:8px;margin-bottom:10px">'+durs.map(function(d,i){return bndDurRow(i,d)}).join('')+'</div>'
    +'<button onclick="addBndDur()" class="btn-glass">+ Add duration tier</button>'
    +'</div>'}
  function bndCatRow(i,c){c=c||{};return'<div data-bnd-cat="'+i+'" style="display:grid;grid-template-columns:.7fr 1fr 2fr .8fr auto;gap:8px;align-items:center;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:10px"><input class="field" data-bc="k" value="'+esc(c.k||'')+'" placeholder="key"><input class="field" data-bc="name" value="'+esc(c.name||'')+'" placeholder="Name"><input class="field" data-bc="desc" value="'+esc(c.desc||'')+'" placeholder="Description"><input class="field" data-bc="price" type="number" step="0.01" value="'+(c.price!=null?c.price:'')+'" placeholder="Base $"><button onclick="removeBndCat('+i+')" class="btn-danger" style="padding:6px 10px">✕</button></div>'}
  function bndDurRow(i,d){d=d||{};return'<div data-bnd-dur="'+i+'" style="display:grid;grid-template-columns:.7fr 1.4fr .8fr 1.2fr auto;gap:8px;align-items:center;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:10px"><input class="field" data-bd="k" value="'+esc(d.k||'')+'" placeholder="key"><input class="field" data-bd="label" value="'+esc(d.label||'')+'" placeholder="Label (e.g. 7 Days)"><input class="field" data-bd="mult" type="number" step="0.1" value="'+(d.mult!=null?d.mult:'')+'" placeholder="×mult"><input class="field" data-bd="badge" value="'+esc(d.badge||'')+'" placeholder="Badge (optional)"><button onclick="removeBndDur('+i+')" class="btn-danger" style="padding:6px 10px">✕</button></div>'}
  function collectBundle(){var s=adminState||ownerState;if(!s)return null;var b={eyebrow:document.getElementById('bnd-eyebrow').value,title:document.getElementById('bnd-title').value,categories:[],durations:[]};
    document.querySelectorAll('[data-bnd-cat]').forEach(function(row){var o={};row.querySelectorAll('[data-bc]').forEach(function(f){o[f.dataset.bc]=f.dataset.bc==='price'?(Number(f.value)||0):f.value});if(o.name)b.categories.push(o)});
    document.querySelectorAll('[data-bnd-dur]').forEach(function(row){var o={};row.querySelectorAll('[data-bd]').forEach(function(f){o[f.dataset.bd]=f.dataset.bd==='mult'?(Number(f.value)||1):f.value});if(o.label)b.durations.push(o)});
    s.bundle=b;return s;}
  function addBndCat(){var s=collectBundle();if(!s)return;s.bundle.categories.push({k:'',name:'',desc:'',price:0});render()}
  function removeBndCat(i){var s=collectBundle();if(!s)return;s.bundle.categories.splice(i,1);render()}
  function addBndDur(){var s=collectBundle();if(!s)return;s.bundle.durations.push({k:'',label:'',mult:1,badge:''});render()}
  function removeBndDur(i){var s=collectBundle();if(!s)return;s.bundle.durations.splice(i,1);render()}
  async function saveBundle(){var s=collectBundle();if(!s)return;var r=await fetch('/api/admin/state',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(s)}),d=await r.json();if(!r.ok)return notice(d.error||'Save failed','red');if(ownerState)ownerState=d;else adminState=d;products=d.products;site=d;render();notice('Bundle saved')}

  // ===== CONTENT TAB =====
  function contentTab(){var s=adminState||ownerState;var c=(s&&s.content)||{};
    var feats=Array.isArray(c.features)?c.features:[];var spec=Array.isArray(c.specialty)?c.specialty:[];var trust=Array.isArray(c.trust)?c.trust:[];var faq=Array.isArray(c.faq)?c.faq:[];
    var sh=c.specialtyHead||{};var fh=c.faqHead||{};
    return'<div class="glass" style="border-radius:14px;padding:24px;max-width:860px"><div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:6px"><h2 style="font-size:20px;font-weight:800;color:#fff;margin:0">Landing Page Content</h2><button onclick="saveContent()" class="btn-primary" style="padding:10px 20px;font-size:13px">Save Content</button></div><p style="font-size:12px;color:rgba(255,255,255,.35);margin-bottom:22px">Edit every section of the homepage and FAQ page.</p>'
    // Feature columns
    +'<div style="margin-bottom:24px">'+fieldLabel('Feature Columns (2 shown near top of homepage)')+'<div id="ct-feats" style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px">'+feats.map(function(f,i){return ctFeatRow(i,f)}).join('')+'</div><button onclick="addCtFeat()" class="btn-glass">+ Add feature</button></div>'
    // Trust strip
    +'<div style="margin-bottom:24px">'+fieldLabel('Trust Strip Items')+'<div id="ct-trust" style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px">'+trust.map(function(t,i){return ctTrustRow(i,t)}).join('')+'</div><button onclick="addCtTrust()" class="btn-glass">+ Add trust item</button></div>'
    // Specialty
    +'<div style="margin-bottom:24px;border-top:1px solid rgba(255,255,255,.06);padding-top:18px"><div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:12px"><label>'+fieldLabel('Specialty Eyebrow')+'<input id="ct-spec-eyebrow" class="field" value="'+esc(sh.eyebrow||'')+'"></label><label>'+fieldLabel('Specialty Title')+'<input id="ct-spec-title" class="field" value="'+esc(sh.title||'')+'"></label></div>'+fieldLabel('Specialty Cards')+'<div id="ct-spec" style="display:flex;flex-direction:column;gap:10px;margin-bottom:8px">'+spec.map(function(sp,i){return ctSpecRow(i,sp)}).join('')+'</div><button onclick="addCtSpec()" class="btn-glass">+ Add specialty card</button></div>'
    // FAQ
    +'<div style="border-top:1px solid rgba(255,255,255,.06);padding-top:18px"><div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:12px"><label>'+fieldLabel('FAQ Eyebrow')+'<input id="ct-faq-eyebrow" class="field" value="'+esc(fh.eyebrow||'')+'"></label><label>'+fieldLabel('FAQ Title')+'<input id="ct-faq-title" class="field" value="'+esc(fh.title||'')+'"></label></div>'+fieldLabel('FAQ Items')+'<div id="ct-faq" style="display:flex;flex-direction:column;gap:10px;margin-bottom:8px">'+faq.map(function(q,i){return ctFaqRow(i,q)}).join('')+'</div><button onclick="addCtFaq()" class="btn-glass">+ Add FAQ item</button></div>'
    +'</div>'}
  function ctFeatRow(i,f){f=f||{};return'<div data-ct-feat="'+i+'" style="display:grid;grid-template-columns:1fr 2fr auto;gap:8px;align-items:start;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:10px"><input class="field" data-cf="title" value="'+esc(f.title||'')+'" placeholder="Title"><input class="field" data-cf="body" value="'+esc(f.body||'')+'" placeholder="Body text"><button onclick="removeCtFeat('+i+')" class="btn-danger" style="padding:6px 10px">✕</button></div>'}
  function ctTrustRow(i,t){return'<div data-ct-trust="'+i+'" style="display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:10px"><input class="field" data-ctt="v" value="'+esc(t||'')+'" placeholder="Trust item"><button onclick="removeCtTrust('+i+')" class="btn-danger" style="padding:6px 10px">✕</button></div>'}
  function ctSpecRow(i,s){s=s||{};return'<div data-ct-spec="'+i+'" style="background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:12px"><div style="display:grid;grid-template-columns:.8fr 1fr 1.4fr auto;gap:8px;margin-bottom:8px"><select class="field" data-cs="tone"><option'+((s.tone||'blue')==='red'?' selected':'')+'>red</option><option'+((s.tone||'blue')==='blue'?' selected':'')+'>blue</option><option'+((s.tone||'blue')==='gold'?' selected':'')+'>gold</option></select><input class="field" data-cs="tag" value="'+esc(s.tag||'')+'" placeholder="Tag"><input class="field" data-cs="title" value="'+esc(s.title||'')+'" placeholder="Title"><button onclick="removeCtSpec('+i+')" class="btn-danger" style="padding:6px 10px">✕</button></div><input class="field" data-cs="body" value="'+esc(s.body||'')+'" placeholder="Body" style="margin-bottom:8px"><textarea class="field" data-cs="items" style="min-height:56px" placeholder="List items, one per line">'+esc((Array.isArray(s.items)?s.items:[]).join('\n'))+'</textarea></div>'}
  function ctFaqRow(i,q){q=q||{};return'<div data-ct-faq="'+i+'" style="background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:12px"><div style="display:flex;gap:8px;margin-bottom:8px"><input class="field" data-cq="q" value="'+esc(q.q||'')+'" placeholder="Question" style="flex:1"><button onclick="removeCtFaq('+i+')" class="btn-danger" style="padding:6px 10px">✕</button></div><textarea class="field" data-cq="a" style="min-height:60px" placeholder="Answer">'+esc(q.a||'')+'</textarea></div>'}
  function collectContent(){var s=adminState||ownerState;if(!s)return null;var c={features:[],specialtyHead:{eyebrow:document.getElementById('ct-spec-eyebrow').value,title:document.getElementById('ct-spec-title').value},specialty:[],trust:[],faqHead:{eyebrow:document.getElementById('ct-faq-eyebrow').value,title:document.getElementById('ct-faq-title').value},faq:[]};
    document.querySelectorAll('[data-ct-feat]').forEach(function(r){var o={};r.querySelectorAll('[data-cf]').forEach(function(f){o[f.dataset.cf]=f.value});if(o.title)c.features.push(o)});
    document.querySelectorAll('[data-ct-trust]').forEach(function(r){var v=r.querySelector('[data-ctt]').value;if(v)c.trust.push(v)});
    document.querySelectorAll('[data-ct-spec]').forEach(function(r){var o={};r.querySelectorAll('[data-cs]').forEach(function(f){if(f.dataset.cs==='items')o.items=f.value.split('\n').map(function(x){return x.trim()}).filter(Boolean);else o[f.dataset.cs]=f.value});if(o.title)c.specialty.push(o)});
    document.querySelectorAll('[data-ct-faq]').forEach(function(r){var o={};r.querySelectorAll('[data-cq]').forEach(function(f){o[f.dataset.cq]=f.value});if(o.q)c.faq.push(o)});
    s.content=c;return s;}
  function addCtFeat(){var s=collectContent();if(!s)return;s.content.features.push({title:'',body:''});render()}
  function removeCtFeat(i){var s=collectContent();if(!s)return;s.content.features.splice(i,1);render()}
  function addCtTrust(){var s=collectContent();if(!s)return;s.content.trust.push('');render()}
  function removeCtTrust(i){var s=collectContent();if(!s)return;s.content.trust.splice(i,1);render()}
  function addCtSpec(){var s=collectContent();if(!s)return;s.content.specialty.push({tone:'blue',tag:'',title:'',body:'',items:[]});render()}
  function removeCtSpec(i){var s=collectContent();if(!s)return;s.content.specialty.splice(i,1);render()}
  function addCtFaq(){var s=collectContent();if(!s)return;s.content.faq.push({q:'',a:''});render()}
  function removeCtFaq(i){var s=collectContent();if(!s)return;s.content.faq.splice(i,1);render()}
  async function saveContent(){var s=collectContent();if(!s)return;var r=await fetch('/api/admin/state',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(s)}),d=await r.json();if(!r.ok)return notice(d.error||'Save failed','red');if(ownerState)ownerState=d;else adminState=d;products=d.products;site=d;render();notice('Content saved')}
  function collectProducts(){var s=adminState||ownerState;if(!s)return null;
    // scalar fields
    document.querySelectorAll('[data-pk]').forEach(function(el){var i=Number(el.dataset.pi),k=el.dataset.pk;if(!s.products[i])return;
      if(k==='features'){s.products[i].features=el.value.split('\n').map(function(x){return x.trim()}).filter(Boolean)}
      else if(k==='price'||k==='rating'||k==='reviews'){s.products[i][k]=Number(el.value)||0}
      else s.products[i][k]=el.value;
    });
    // duration option rows
    s.products.forEach(function(p,i){
      var wrap=document.querySelector('[data-opts-for="'+i+'"]');if(!wrap)return;
      var opts=[];wrap.querySelectorAll('[data-opt-row]').forEach(function(row){
        var o={};row.querySelectorAll('[data-ok]').forEach(function(f){var k=f.dataset.ok;o[k]=k==='price'?(Number(f.value)||0):f.value});
        if(o.label||o.duration)opts.push({id:Date.now()+Math.floor(Math.random()*1000),label:o.label,duration:o.duration,price:o.price,currency:o.currency,stock:o.stock});
      });
      p.options=opts;
    });
    return s;
  }
  async function saveProducts(){var s=collectProducts();if(!s)return;var r=await fetch('/api/admin/state',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(s)}),d=await r.json();if(!r.ok)return notice(d.error||'Save failed','red');if(ownerState)ownerState=d;else adminState=d;products=d.products;site=d;render();notice('All products saved')}
  function addOption(pi){var s=adminState||ownerState;if(!s||!s.products[pi])return;collectProducts();if(!Array.isArray(s.products[pi].options))s.products[pi].options=[];s.products[pi].options.push({id:Date.now(),label:'',duration:'',price:0,currency:'USD',stock:'IN STOCK'});render()}
  function removeOption(pi,oi){var s=adminState||ownerState;if(!s||!s.products[pi])return;collectProducts();s.products[pi].options.splice(oi,1);render()}
  async function deleteProduct(i){var s=adminState||ownerState;if(!s)return;s.products.splice(i,1);var r=await fetch('/api/admin/state',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(s)}),d=await r.json();if(!r.ok)return notice(d.error||'Failed','red');if(ownerState)ownerState=d;else adminState=d;products=d.products;site=d;render();notice('Product removed')}
  async function addNewProductAndSave(){var s=adminState||ownerState;if(!s)return;collectNewOpts();var feats=(document.getElementById('new-p-features').value||'').split('\n').map(function(x){return x.trim()}).filter(Boolean);var opts=(newProductOpts||[]).filter(function(o){return(o.label&&o.label.trim())||(o.duration&&o.duration.trim())||Number(o.price)>0}).map(function(o){var lbl=(o.label&&o.label.trim())||(o.duration&&o.duration.trim())||'Option';return{id:Date.now()+Math.floor(Math.random()*1000),label:lbl,duration:o.duration||'',price:Number(o.price)||0,currency:o.currency||'USD',stock:o.stock||'IN STOCK'}});s.products.push({id:Date.now(),name:document.getElementById('new-p-name').value||'New Product',game:document.getElementById('new-p-game').value||'ROBLOX',price:Number(document.getElementById('new-p-price').value)||0,currency:document.getElementById('new-p-currency').value,stock:document.getElementById('new-p-stock').value,rating:Number(document.getElementById('new-p-rating').value)||5,reviews:0,description:document.getElementById('new-p-desc').value||'',details:document.getElementById('new-p-details').value||'',features:feats,options:opts,image:document.getElementById('new-p-image').value||'',video:document.getElementById('new-p-video').value||''});var r=await fetch('/api/admin/state',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(s)}),d=await r.json();if(!r.ok)return notice(d.error||'Failed','red');if(ownerState)ownerState=d;else adminState=d;products=d.products;site=d;newProductOpts=[];newProductDraft={};dashboardTab='products';render();notice('Product added')}
  function dz(target,accept,label,current,isVid){var pv=current?(isVid?'<video class="dz-preview" src="'+esc(current)+'" muted playsinline></video>':'<img class="dz-preview" src="'+esc(current)+'">'):'';return '<div class="dropzone'+(current?' has-media':'')+'" data-dz="'+target+'" ondragover="dzOver(event)" ondragleave="dzLeave(event)" ondrop="dzDrop(event)" onclick="if(event.target.tagName!==&quot;INPUT&quot;)this.querySelector(&quot;input&quot;).click()"><div class="dz-preview-wrap">'+pv+'</div><div class="dz-hint"><b>'+label+'</b>Drag &amp; drop or click to browse</div><div class="dz-bar"></div><input type="file" accept="'+accept+'" class="hidden" onchange="dzPick(event)"></div>'}
  function dzOver(e){e.preventDefault();e.currentTarget.classList.add('dragover')}
  function dzLeave(e){e.currentTarget.classList.remove('dragover')}
  function dzDrop(e){e.preventDefault();var z=e.currentTarget;z.classList.remove('dragover');var f=e.dataTransfer.files&&e.dataTransfer.files[0];if(f)dzHandleFile(z,f)}
  function dzPick(e){var f=e.target.files[0];if(f)dzHandleFile(e.target.closest('.dropzone'),f)}
  function dzSetPreview(zone,url,isVid){zone.classList.add('has-media');var wrap=zone.querySelector('.dz-preview-wrap');wrap.innerHTML=isVid?'<video class="dz-preview" src="'+url+'" muted playsinline></video>':'<img class="dz-preview" src="'+url+'">'}
  function dzApply(target,url){var parts=target.split(':');if(parts[0]==='p'){var i=Number(parts[1]),field=parts[2],s=adminState||ownerState;if(s&&s.products[i])s.products[i][field]=url;var inp=document.querySelector('[data-pk="'+field+'"][data-pi="'+i+'"]');if(inp)inp.value=url}else if(parts[0]==='new'){var el=document.getElementById('new-p-'+parts[1]);if(el)el.value=url}else if(parts[0]==='hero'){heroDraft[parts[1]]=url;var h=document.getElementById('hero-'+parts[1]);if(h)h.value=url}}
  async function dzHandleFile(zone,file){if(!file)return;if(file.size>10000000)return notice('Max 10 MB','red');var isVid=/^video\//.test(file.type)||/\.(mp4|webm)$/i.test(file.name);var localUrl=URL.createObjectURL(file);dzSetPreview(zone,localUrl,isVid);zone.classList.add('busy');var bar=zone.querySelector('.dz-bar');if(bar)bar.style.width='70%';var form=new FormData();form.append('file',file);try{var r=await fetch('/api/admin/upload',{method:'POST',body:form});var d=await r.json().catch(function(){return{}});if(!r.ok){zone.classList.remove('busy');if(bar)bar.style.width='0';return notice(d.error||'Upload failed','red')}dzApply(zone.dataset.dz,d.url);dzSetPreview(zone,d.url,isVid);if(bar)bar.style.width='100%';notice('Uploaded')}catch(err){notice('Upload failed — network error','red')}zone.classList.remove('busy');setTimeout(function(){if(bar)bar.style.width='0'},600)}
  function usersTab(isOwner){return'<div style="display:flex;flex-direction:column;gap:12px"><div style="display:flex;gap:10px"><input oninput="searchUsers()" id="user-search" class="field" style="max-width:260px" placeholder="Search users..."><span style="font-size:13px;color:rgba(255,255,255,.25);align-self:center">'+adminUsers.length+' registered users</span></div>'+(adminUsers.map(function(u){return'<div class="glass" style="border-radius:12px;padding:16px;display:flex;align-items:center;justify-content:space-between"><div><p style="font-weight:700">'+esc(u.name)+'</p><p style="font-size:11px;color:rgba(255,255,255,.35)">'+esc(u.email)+' · '+esc(u.provider)+' · Joined '+new Date(u.createdAt).toLocaleDateString()+'</p><p style="font-size:11px;color:rgba(255,255,255,.25)">Purchases: '+(u.purchaseCount||0)+' · Spent: $'+((u.totalSpent||0)).toFixed(2)+' · IPs: '+(u.ips||[]).join(', ')+'</p></div><div style="display:flex;align-items:center;gap:8px"><span style="font-size:10px;padding:4px 10px;border-radius:20px;border:1px solid;'+(u.status==='active'?'background:rgba(59,130,246,.08);border-color:rgba(59,130,246,.25);color:#60a5fa':'background:rgba(239,68,68,.08);border-color:rgba(239,68,68,.25);color:#f87171')+'">'+u.status+'</span><span style="font-size:10px;padding:4px 10px;border-radius:20px;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);color:rgba(255,255,255,.35)">'+u.role+'</span>'+(isOwner?'<button onclick="toggleUserStatus(\''+u.id+'\',\''+(u.status==='active'?'banned':'active')+'\')" class="btn-glass">'+(u.status==='active'?'Ban':'Unban')+'</button>':'')+'</div></div>'}).join('')||'<p style="color:rgba(255,255,255,.25);padding:40px 0;text-align:center">No users registered yet.</p>')+'</div>'}
  async function searchUsers(){var q=document.getElementById('user-search').value,r=await fetch('/api/admin/users?q='+encodeURIComponent(q));if(r.ok){var d=await r.json();adminUsers=d.users;render()}}
  async function toggleUserStatus(id,newStatus){var r=await fetch('/api/admin/users/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:newStatus})});if(r.ok){notice('User updated');var r2=await fetch('/api/admin/users'),d=await r2.json();adminUsers=d.users;render()}else notice('Update failed','red')}
  function logsTab(isOwner){var types=['all','auth','purchase','link','system','product','upload'];return'<div style="display:flex;flex-direction:column;gap:12px"><div style="display:flex;flex-wrap:wrap;gap:6px;align-items:center"><span style="font-size:12px;color:rgba(255,255,255,.35)">Filter:</span>'+types.map(function(t){return'<button onclick="logFilter=\''+t+'\';loadDashboardData();render()" style="padding:6px 14px;border-radius:20px;border:1px solid;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .2s;'+(logFilter===t?'border-color:rgba(59,130,246,.4);background:rgba(59,130,246,.08);color:#60a5fa':'border-color:rgba(255,255,255,.06);background:transparent;color:rgba(255,255,255,.45)')+'">'+t.charAt(0).toUpperCase()+t.slice(1)+'</button>'}).join('')+(isOwner?'<button onclick="clearLogs()" class="btn-danger" style="margin-left:auto">Clear All Logs</button>':'')+'</div><div class="glass" style="border-radius:12px;overflow:hidden"><div style="overflow-x:auto;max-height:500px;overflow-y:auto"><table style="width:100%;font-size:11px"><thead><tr style="border-bottom:1px solid rgba(255,255,255,.06);color:rgba(255,255,255,.35)"><th style="padding:10px;text-align:left">Time</th><th style="padding:10px;text-align:left">Type</th><th style="padding:10px;text-align:left">Action</th><th style="padding:10px;text-align:left">User</th><th style="padding:10px;text-align:left">IP</th><th style="padding:10px;text-align:left">Details</th></tr></thead><tbody>'+(adminLogs.map(function(l){return'<tr class="log-row" style="border-bottom:1px solid rgba(255,255,255,.02)"><td style="padding:10px;color:rgba(255,255,255,.4)">'+ago(l.timestamp)+'</td><td style="padding:10px"><span style="color:'+logColor(l.type)+';font-weight:600;text-transform:uppercase">'+l.type+'</span></td><td style="padding:10px">'+esc(l.action)+'</td><td style="padding:10px;color:rgba(255,255,255,.35)">'+esc(l.user)+'</td><td style="padding:10px;color:rgba(255,255,255,.25)">'+esc(l.ip)+'</td><td style="padding:10px;color:rgba(255,255,255,.3);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(JSON.stringify(l.details).slice(0,80))+'</td></tr>'}).join('')||'<tr><td colspan="6" style="padding:30px;text-align:center;color:rgba(255,255,255,.25)">No logs matching filter.</td></tr>')+'</tbody></table></div></div></div>'}
  async function clearLogs(){if(!confirm('Delete all logs permanently?'))return;var r=await fetch('/api/admin/logs/clear',{method:'POST'});if(r.ok){adminLogs=[];render();notice('All logs cleared')}else notice('Clear failed','red')}
  function statsTab(){return'<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px"><div class="stat-card"><p class="section-header">Total Products</p><b style="display:block;margin-top:8px;font-size:28px">'+(adminStats.totalProducts||0)+'</b></div><div class="stat-card"><p class="section-header">Total Users</p><b style="display:block;margin-top:8px;font-size:28px">'+(adminStats.totalUsers||0)+'</b></div><div class="stat-card"><p class="section-header">Active Users</p><b style="display:block;margin-top:8px;font-size:28px;color:#60a5fa">'+(adminStats.activeUsers||0)+'</b></div><div class="stat-card"><p class="section-header">Total Revenue</p><b style="display:block;margin-top:8px;font-size:28px;color:var(--neon-accent)">$'+((adminStats.totalRevenue||0)).toFixed(2)+'</b></div><div class="stat-card"><p class="section-header">Auth Logs</p><b style="display:block;margin-top:8px;font-size:24px;color:'+logColor('auth')+'">'+(adminStats.authLogs||0)+'</b></div><div class="stat-card"><p class="section-header">Purchase Logs</p><b style="display:block;margin-top:8px;font-size:24px;color:'+logColor('purchase')+'">'+(adminStats.purchaseLogs||0)+'</b></div><div class="stat-card"><p class="section-header">Link Logs</p><b style="display:block;margin-top:8px;font-size:24px;color:'+logColor('link')+'">'+(adminStats.linkLogs||0)+'</b></div><div class="stat-card"><p class="section-header">Total Logs</p><b style="display:block;margin-top:8px;font-size:24px;color:rgba(255,255,255,.45)">'+(adminStats.totalLogs||0)+'</b></div><div class="glass" style="border-radius:12px;padding:18px;grid-column:1/-1"><p class="section-header" style="margin-bottom:12px">Recent Activity</p>'+((adminStats.recentLogs||[]).map(function(l){return'<div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.02);font-size:11px"><span style="color:'+logColor(l.type)+';font-weight:600;text-transform:uppercase;width:60px;flex-shrink:0">'+l.type+'</span><span style="flex:1">'+esc(l.action)+'</span><span style="color:rgba(255,255,255,.25)">'+ago(l.timestamp)+'</span></div>'}).join('')||'<p style="color:rgba(255,255,255,.25)">No recent activity.</p>')+'</div></div>'}

  // ===================================================================
  // Interactive / scroll-reactive layer  (GSAP + ScrollTrigger + Lenis)
  // Motion only — no content, layout, or theme is changed here.
  // ===================================================================
  var REDUCED = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var __lpCtx=null;        // gsap.context for the home page (killed & rebuilt per render)
  var __tiltBound=false;   // tilt uses one delegated pointer handler for the whole doc

  // --- Nav: transparent -> blurred glass once scrolled past 50px ---
  function updateNavState(){
    var pill=document.getElementById('nav-pill'); if(!pill) return;
    var y = window.__sTop!=null ? window.__sTop : (window.pageYOffset||0);
    pill.classList.toggle('scrolled', y>50);
  }

  // --- Subtle magnetic pull + glow on the hero CTAs ---
  function bindMagnetic(el, strength){
    if(!el || el.__mag) return; el.__mag=true; strength=strength||0.35;
    el.addEventListener('pointermove', function(e){
      if(REDUCED) return;
      var r=el.getBoundingClientRect();
      var mx=e.clientX-(r.left+r.width/2), my=e.clientY-(r.top+r.height/2);
      if(window.gsap) gsap.to(el,{x:mx*strength,y:my*strength,duration:.4,ease:'power3.out'});
    });
    el.addEventListener('pointerleave', function(){
      if(window.gsap) gsap.to(el,{x:0,y:0,duration:.55,ease:'elastic.out(1,0.4)'});
    });
  }

  // --- 3D tilt for category cards (delegated; emphasises the colored glow) ---
  function bindTilt(){
    if(__tiltBound) return; __tiltBound=true;
    document.addEventListener('pointermove', function(e){
      if(REDUCED || !window.gsap) return;
      var card=e.target.closest && e.target.closest('.spec-card'); if(!card) return;
      var r=card.getBoundingClientRect();
      var px=(e.clientX-r.left)/r.width-0.5, py=(e.clientY-r.top)/r.height-0.5;
      gsap.to(card,{rotationY:px*10,rotationX:-py*10,transformPerspective:900,transformOrigin:'center',duration:.4,ease:'power2.out'});
      var glow=card.querySelector('.glow'); if(glow) gsap.to(glow,{opacity:.85,scale:1.15,duration:.4});
    });
    document.addEventListener('pointerout', function(e){
      if(!window.gsap) return;
      var card=e.target.closest && e.target.closest('.spec-card'); if(!card) return;
      if(card.contains(e.relatedTarget)) return;
      gsap.to(card,{rotationY:0,rotationX:0,duration:.6,ease:'power3.out'});
      var glow=card.querySelector('.glow'); if(glow) gsap.to(glow,{opacity:.5,scale:1,duration:.6});
    });
  }

  // --- Master entry point, re-run safely after every render() ---
  function initInteractions(){
    updateNavState();
    if(!window.gsap || !hasGSAP){                 // GSAP not ready yet: ensure nothing is left hidden
      document.querySelectorAll('[data-reveal]').forEach(function(el){el.style.opacity='';el.style.transform=''});
      return;
    }
    var isHome=(location.pathname.replace(/\/$/,'')||'/')==='/';
    if(__lpCtx){ __lpCtx.revert(); __lpCtx=null; }  // tear down previous page's triggers/tweens
    bindTilt();
    if(!isHome){ ScrollTrigger.refresh(); return; }

    __lpCtx = gsap.context(function(){
      var hero=document.getElementById('lp-hero');

      if(REDUCED){
        // Respect reduced motion: reveal everything instantly, no scroll-linked motion.
        gsap.set(['#lp-hero .guarantee-pill','#lp-hero .hero-head','#lp-hero .hero-sub','#lp-brand .wordmark','#lp-brand .cta-pill','.feat-col','.video-card','.spec-card','#lp-featured .glass-card'],{clearProps:'all',opacity:1});
      } else {
        // ---- Hero load: staggered fade-up + slight scale-in ----
        var heroTl=gsap.timeline({defaults:{ease:'power3.out'}});
        heroTl.from('#lp-hero .guarantee-pill',{opacity:0,y:24,duration:.6})
              .from('#lp-hero .hero-head',{opacity:0,y:34,scale:.96,duration:.8},'-=0.35')
              .from('#lp-hero .hero-sub',{opacity:0,y:20,duration:.6},'-=0.5')
              .from('#lp-brand .wordmark',{opacity:0,y:30,scale:.94,duration:.9},'-=0.3')  // glowing INERTIA
              .from('#lp-brand .cta-pill',{opacity:0,y:18,stagger:.09,duration:.5},'-=0.55');

        // ---- Hero exit: gently fade + drift up as you scroll away ----
        if(hero){
          gsap.to(hero,{yPercent:-14,opacity:0,ease:'none',
            scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:true}});
        }

        // ---- Feature cards: staggered fade-up on enter (~100ms apart) ----
        gsap.from('.feat-col',{opacity:0,y:40,duration:.7,ease:'power3.out',stagger:.1,
          scrollTrigger:{trigger:'.feat-col',start:'top 85%'}});

        // ---- Video: scale 0.95 -> 1.0 + fade as it nears viewport center ----
        gsap.from('.video-card',{opacity:0,scale:.95,duration:.9,ease:'power2.out',
          scrollTrigger:{trigger:'.video-card',start:'top 80%'}});

        // ---- Category cards: staggered slide-up + fade (tilt bound above) ----
        gsap.from('.spec-card',{opacity:0,y:54,duration:.75,ease:'power3.out',stagger:.12,
          scrollTrigger:{trigger:'.spec-card',start:'top 85%'}});

        // ---- Featured products: slide up from the bottom + blur-to-focus ----
        gsap.from('#lp-featured .glass-card',{opacity:0,y:60,filter:'blur(10px)',duration:.85,ease:'power3.out',stagger:.08,
          scrollTrigger:{trigger:'#lp-featured',start:'top 82%'},
          clearProps:'filter'});
      }

      // Micro-interactions on the primary hero CTAs (light = Browse Catalog, dark = Join Community)
      document.querySelectorAll('#lp-brand .cta-pill').forEach(function(b){ bindMagnetic(b,0.32); });
    });

    ScrollTrigger.refresh();
  }

  function render(){
    var route=location.pathname.replace(/\/$/,'')||'/';
    var view;
    var productMatch=route.match(/^\/product\/(.+)$/);
    if(productMatch){var pid=productMatch[1];view=function(){return productDetailPage(pid)}}
    else{view={'/':home,'/products':productsPage,'/cart':cartPage,'/login':login,'/reviews':reviewsPage,'/faq':faqPage,'/funpay':funpay,'/discord':discord,'/support':support,'/dashboard/login':dashboardLoginPage,'/dashboard':dashboardPage}[route]||home}
    document.getElementById('app').innerHTML=view();
    document.body.classList.toggle('dash-no-snow',route==='/dashboard'||route==='/dashboard/login');
    document.querySelectorAll('[data-nav]').forEach(function(a){a.onclick=function(e){e.preventDefault();go(a.getAttribute('href'))}});
    requestAnimationFrame(function(){var isHome=(location.pathname.replace(/\/$/,'')||'/')==='/';if(hasGSAP){gsap.fromTo('#app',{opacity:.55,y:10},{opacity:1,y:0,duration:.35,ease:'power2.out',overwrite:!0});if(!isHome)gsap.fromTo('.glass-card',{opacity:.4,scale:.985},{opacity:1,scale:1,duration:.35,stagger:.04,ease:'power2.out',overwrite:!0})}if(typeof initInteractions==='function')initInteractions()})
  }

  async function hydrate(){
    try{var r=await fetch('/api/public');if(r.ok){var d=await r.json();products=d.products;site=d;render()}}catch(e){}
    try{r=await fetch('/api/auth/me');if(r.ok){d=await r.json();if(d.authenticated){if(d.owner)ownerState=await(await fetch('/api/admin/state')).json();else adminState=await(await fetch('/api/admin/state')).json()}}}catch(e){}
    try{r=await fetch('/api/auth/oauth-config');if(r.ok)oauthConfig=await r.json()}catch(e){}
    render();
  }
  render();
  hydrate();
  </script>
</body>
</html>