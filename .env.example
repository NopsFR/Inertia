# ── Inertia Core ────────────────────────────────────────────────────
INERTIA_ADMIN_PASSWORD=replace-with-a-long-unique-password
INERTIA_SECRET_KEY=replace-with-a-long-random-secret-key
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/inertia?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development
# Public base URL for OAuth redirect URIs (production). e.g. https://yourdomain.com
PUBLIC_URL=

# ── OAuth Providers ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# ── Discord Bot Tokens ──────────────────────────────────────────────
# Sales Bot — posts real-time purchases to #sales channel
SALES_BOT_TOKEN=MTUzMjIxODA3NDgxMDU1MjU0MQ
# Ticket Bot — /purchase command, Stripe checkout, private ticket channels
TICKET_BOT_TOKEN=MTUzMjIxODI5Mzg0MTI5NzQ2OA
# Management Bot — admin dashboard sync, logs, product management
MANAGEMENT_BOT_TOKEN=MTUzMjIxODM4NzA4MDQxNzQ0Mg
# Authing Bot — Discord OAuth role assignment (Member/Customer roles)
AUTHING_BOT_TOKEN=MTUzMjIxODUwOTEwOTYyNDk2Mg

# ── Discord Server IDs ──────────────────────────────────────────────
DISCORD_GUILD_ID=YOUR_GUILD_ID_HERE
VOUCHES_CHANNEL_ID=1532088381318893791
TICKET_SUPPORT_CHANNEL_ID=1531894670542508092
SALES_CHANNEL_ID=1533366468153049178
MANAGEMENT_CHANNEL_ID=1533366670519828592

# ── Discord Role IDs ─────────────────────────────────────────────────
INERTIA_ROLE_ID=1531894242824294441
SERVER_BOOSTER_ROLE_ID=1532081420011311114
CUSTOMER_ROLE_ID=1533212375283400905
SUPPORT_ROLE_ID=1533227778286162162
MANAGEMENT_ROLE_ID=1533227946653782016
RESELLER_ROLE_ID=1533228935578521610
MEDIA_ROLE_ID=1533229534206365727
MEMBER_ROLE_ID=1533279112913879151

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
